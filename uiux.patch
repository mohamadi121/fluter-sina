#### 5. Contract Tests
```diff
--- /dev/null
+++ b/test/api/auth_api_client_test.dart
@@ -0,0 +1,110 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:dio/dio.dart';
+import 'package:http_mock_adapter/http_mock_adapter.dart';
+import 'package:asoud/api/auth_api_client.dart';
+import 'package:asoud/core/models/dto/base_response_dto.dart';
+import 'package:asoud/core/models/dto/auth_dto.dart';
+
+void main() {
+  group('Auth API Client Contract Tests', () {
+    late Dio dio;
+    late DioAdapter dioAdapter;
+    late AuthApiClient authApiClient;
+
+    setUp(() {
+      dio = Dio(BaseOptions(baseUrl: 'https://api.asoud.ir/api/v1'));
+      dioAdapter = DioAdapter(dio: dio);
+      authApiClient = AuthApiClient(dio);
+    });
+
+    group('PIN Create', () {
+      test('should send correct request format', () async {
+        // Arrange
+        const mobileNumber = '+989123456789';
+        final expectedResponse = {
+          'success': true,
+          'code': 200,
+          'data': {},
+          'message': 'Pin has been created successfully'
+        };
+
+        dioAdapter.onPost(
+          '/user/pin/create/',
+          (server) => server.reply(200, expectedResponse),
+          data: Matchers.any,
+          headers: Matchers.any,
+        );
+
+        // Act
+        final result = await authApiClient.createPin(mobileNumber);
+
+        // Assert
+        expect(result.success, isTrue);
+        expect(result.code, equals(200));
+        expect(result.message, equals('Pin has been created successfully'));
+        
+        // Verify request was multipart/form-data
+        final history = dioAdapter.history;
+        expect(history.length, equals(1));
+        expect(history.first.request.headers['content-type'], 
+               contains('multipart/form-data'));
+      });
+    });
+  });
+}
```

